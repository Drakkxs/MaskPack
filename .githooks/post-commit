#!/bin/sh

# 1. Ask Git directly for the absolute path of the project root
REPO_ROOT=$(git rev-parse --show-toplevel)

# 2. Extract the clean folder name (e.g., MaskPack)
PROJECT_NAME=$(basename "$REPO_ROOT")

# 3. Print debugging details to the console during commit
echo ""
echo "----------------------------------------"
echo "[Post-Commit] Project Name: $PROJECT_NAME"
echo "[Post-Commit] Target Zip:   ${PROJECT_NAME}.zip"
echo "----------------------------------------"

# 4. Generate the archive
git archive --format=zip --output="${PROJECT_NAME}.zip" HEAD

# 5. Print success or failure status
if [ $? -eq 0 ]; then
    echo "[SUCCESS] Archive created successfully!"
else
    echo "[ERROR] Failed to create zip archive."
fi
echo ""